@startuml
title <size:24>Container View: ArenaServer Game Platform</size>\n<size:24>Target service responsibilities and dependencies</size>

set separator none
top to bottom direction
skinparam ranksep 60
skinparam nodesep 30
hide stereotype

<style>
  root {
    BackgroundColor: #ffffff;
    FontColor: #444444;
  }
  // Element,Container,InProgress
  .Element-RWxlbWVudCxDb250YWluZXIsSW5Qcm9ncmVzcw== {
    BackgroundColor: #167d73;
    LineColor: #0f5750;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #ffffff;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 450;
  }
  // Element,Container,Planned
  .Element-RWxlbWVudCxDb250YWluZXIsUGxhbm5lZA== {
    BackgroundColor: #438dd5;
    LineColor: #2e6295;
    LineStyle: 10-10;
    LineThickness: 2;
    FontColor: #ffffff;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 450;
  }
  // Element,Person
  .Element-RWxlbWVudCxQZXJzb24= {
    BackgroundColor: #08427b;
    LineColor: #052e56;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #ffffff;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 450;
  }
  // Element,Software System,External,Planned
  .Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0sRXh0ZXJuYWwsUGxhbm5lZA== {
    BackgroundColor: #747d8c;
    LineColor: #515762;
    LineStyle: 10-10;
    LineThickness: 2;
    FontColor: #ffffff;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 450;
  }
  // Relationship
  .Relationship-UmVsYXRpb25zaGlw {
    LineThickness: 2;
    LineStyle: 10-10;
    LineColor: #444444;
    FontColor: #444444;
    FontSize: 24;
  }
  // ArenaServer Game Platform
  .Boundary-QXJlbmFTZXJ2ZXIgR2FtZSBQbGF0Zm9ybQ== {
    BackgroundColor: #ffffff;
    LineColor: #0b4884;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #ffffff;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
  }
</style>

person "==Game Client\n<size:16>[Person]</size>\n\nPC, mobile, or console game client." <<Element-RWxlbWVudCxQZXJzb24=>> as GameClient
rectangle "==Redis\n<size:16>[Software System]</size>\n\nTarget cache for presence, tickets, and recoverable state." <<Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0sRXh0ZXJuYWwsUGxhbm5lZA==>> as Redis
rectangle "==MySQL\n<size:16>[Software System]</size>\n\nTarget durable store for accounts and game results." <<Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0sRXh0ZXJuYWwsUGxhbm5lZA==>> as MySQL

rectangle "ArenaServer Game Platform\n<size:16>[Software System]</size>" <<Boundary-QXJlbmFTZXJ2ZXIgR2FtZSBQbGF0Zm9ybQ==>> {
  rectangle "==Auth Service\n<size:16>[Container: C++]</size>\n\nVerifies identity, issues tokens, and authorizes operations." <<Element-RWxlbWVudCxDb250YWluZXIsUGxhbm5lZA==>> as ArenaServerGamePlatform.AuthService
  rectangle "==Lobby Service\n<size:16>[Container: C++]</size>\n\nManages online state, friends, parties, and chat." <<Element-RWxlbWVudCxDb250YWluZXIsUGxhbm5lZA==>> as ArenaServerGamePlatform.LobbyService
  rectangle "==Match Service\n<size:16>[Container: C++]</size>\n\nQueues players, applies match rules, and assigns rooms." <<Element-RWxlbWVudCxDb250YWluZXIsUGxhbm5lZA==>> as ArenaServerGamePlatform.MatchService
  rectangle "==Room Server\n<size:16>[Container: C++]</size>\n\nOwns authoritative room state, input handling, fixed ticks, and combat." <<Element-RWxlbWVudCxDb250YWluZXIsUGxhbm5lZA==>> as ArenaServerGamePlatform.RoomServer
  rectangle "==Gateway Service\n<size:16>[Container: C++17, Linux epoll, Reactor]</size>\n\nOwns client connections, protocol framing, session routing, and connection safety." <<Element-RWxlbWVudCxDb250YWluZXIsSW5Qcm9ncmVzcw==>> as ArenaServerGamePlatform.GatewayService
  rectangle "==Storage Service\n<size:16>[Container: C++]</size>\n\nProvides bounded cache access and durable persistence for account and game data." <<Element-RWxlbWVudCxDb250YWluZXIsUGxhbm5lZA==>> as ArenaServerGamePlatform.StorageService
}

ArenaServerGamePlatform.StorageService --> Redis <<Relationship-UmVsYXRpb25zaGlw>> : "Caches expiring state\n<size:16>[Planned]</size>"
ArenaServerGamePlatform.StorageService --> MySQL <<Relationship-UmVsYXRpb25zaGlw>> : "Persists durable records\n<size:16>[Planned]</size>"
GameClient --> ArenaServerGamePlatform.GatewayService <<Relationship-UmVsYXRpb25zaGlw>> : "Connects and sends game messages\n<size:16>[TCP; UDP/WebSocket optional later]</size>"
ArenaServerGamePlatform.GatewayService --> ArenaServerGamePlatform.AuthService <<Relationship-UmVsYXRpb25zaGlw>> : "Validates login and reconnect identity\n<size:16>[Internal request/response TBD]</size>"
ArenaServerGamePlatform.GatewayService --> ArenaServerGamePlatform.LobbyService <<Relationship-UmVsYXRpb25zaGlw>> : "Routes lobby messages\n<size:16>[Internal messaging TBD]</size>"
ArenaServerGamePlatform.GatewayService --> ArenaServerGamePlatform.MatchService <<Relationship-UmVsYXRpb25zaGlw>> : "Routes matchmaking requests\n<size:16>[Internal messaging TBD]</size>"
ArenaServerGamePlatform.GatewayService --> ArenaServerGamePlatform.RoomServer <<Relationship-UmVsYXRpb25zaGlw>> : "Routes room commands and state updates\n<size:16>[Internal messaging TBD]</size>"
ArenaServerGamePlatform.MatchService --> ArenaServerGamePlatform.RoomServer <<Relationship-UmVsYXRpb25zaGlw>> : "Requests room allocation\n<size:16>[Internal request/response TBD]</size>"
ArenaServerGamePlatform.AuthService --> ArenaServerGamePlatform.StorageService <<Relationship-UmVsYXRpb25zaGlw>> : "Reads account data\n<size:16>[Internal request/response TBD]</size>"
ArenaServerGamePlatform.LobbyService --> ArenaServerGamePlatform.StorageService <<Relationship-UmVsYXRpb25zaGlw>> : "Reads and writes social state\n<size:16>[Internal request/response TBD]</size>"
ArenaServerGamePlatform.RoomServer --> ArenaServerGamePlatform.StorageService <<Relationship-UmVsYXRpb25zaGlw>> : "Loads checkpoints and persists final results\n<size:16>[Internal messaging TBD]</size>"

@enduml